<Window x:Class="RobloxPiano.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RobloxPiano.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="Roblox Piano" Height="768" Width="1366" MinHeight="680" MinWidth="1100"
        Icon="/Resources/app_icon.ico"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Title / Command Area & Navigation -->
        <Border Grid.Row="0" Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Identity -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,32,0">
                    <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zM7 7h2v6H7zm4 0h2v6h-2zm4 0h2v6h-2z" Fill="{StaticResource Accent.Primary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" />
                    <TextBlock Text="Roblox Piano" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Primary Navigation -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="Player" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Player" IsChecked="True"/>
                    <RadioButton Content="Library" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Library" />
                    <RadioButton Content="Transcribe" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Transcribe" />
                    <RadioButton Content="Settings" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                </StackPanel>

                <!-- Right Status / Actions -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Roblox Status Indicator (Radius = 6, within <= 8 rule) -->
                    <Border Background="{StaticResource Surface.Base}" CornerRadius="6" Padding="10,5" Margin="0,0,16,0" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Status.Offline}" Margin="0,0,8,0" />
                            <TextBlock Text="Roblox 연결 안 됨" FontSize="12" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    
                    <Button Padding="8,4" Background="Transparent" BorderThickness="0" Margin="0,0,8,0" ToolTip="Overlay Toggle (F4)">
                        <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14z" Fill="{StaticResource Text.Secondary}" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="0" />
    </Grid>
</Window>
