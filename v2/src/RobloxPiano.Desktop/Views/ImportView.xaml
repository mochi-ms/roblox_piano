<UserControl x:Class="RobloxPiano.Desktop.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RobloxPiano.Desktop.ViewModels"
             mc:Ignorable="d" 
             Background="{StaticResource Background.Root}"
             d:DesignHeight="700" d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="{StaticResource Background.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Area -->
        <StackPanel Grid.Row="0" Margin="32,24,32,16">
            <TextBlock Text="악보 가져오기" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,4" />
            <TextBlock Text="MIDI 또는 MML 파일을 추가해 바로 연주할 수 있습니다." FontSize="13" Foreground="{StaticResource Text.Secondary}" />
        </StackPanel>

        <!-- 2. Drop Zone & File Selection -->
        <Border Grid.Row="1" Margin="32,0,32,16" Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1.5" CornerRadius="8" Padding="24"
                AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" DragEnter="DropZone_DragEnter" x:Name="DropZoneBorder">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"
                              Fill="{StaticResource Accent.Primary}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="파일을 여기에 놓으세요" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="지원 포맷: .mid · .midi · .mml · .txt (MML)" FontSize="12.5" Foreground="{StaticResource Text.Secondary}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="파일 선택" Command="{Binding BrowseFilesCommand}" Style="{StaticResource AccentButtonStyle}" Padding="20,8" FontSize="13" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Import Queue Table -->
        <Grid Grid.Row="2" Margin="32,0,32,16">
            <Border Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <!-- Empty Queue Placeholder -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                        <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14z"
                              Fill="{StaticResource Text.Disabled}" Width="36" Height="36" Stretch="Uniform" Margin="0,0,0,12" HorizontalAlignment="Center" />
                        <TextBlock Text="대기 중인 파일이 없습니다." FontSize="14" FontWeight="Medium" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock Text="위 영역으로 파일을 끌어다 놓거나 '파일 선택' 버튼을 클릭하세요." FontSize="12" Foreground="{StaticResource Text.Tertiary}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Items List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding QueueItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="16,12" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" MinWidth="200" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- File Name & Path -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource Text.Primary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                                                <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="{StaticResource Text.Tertiary}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Source Type Badge -->
                                            <Border Grid.Column="1" Background="{StaticResource Surface.Base}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1">
                                                <TextBlock Text="{Binding SourceType}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" />
                                            </Border>

                                            <!-- Status Text Badge -->
                                            <Border Grid.Column="2" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Background" Value="#1A34D399" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                <Setter Property="Background" Value="#1AEF4444" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsImporting}" Value="True">
                                                                <Setter Property="Background" Value="#1A5B8DEF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="Medium">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Status.Success}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Status.Danger}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsImporting}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Accent.Primary}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Metadata / Error Text -->
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <!-- If Completed -->
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding DurationText}" FontSize="11.5" Foreground="{StaticResource Text.Secondary}" Margin="0,0,8,0" />
                                                    <TextBlock Text="·" FontSize="11.5" Foreground="{StaticResource Text.Tertiary}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding NotesText}" FontSize="11.5" Foreground="{StaticResource Text.Secondary}" Margin="0,0,8,0" />
                                                    <TextBlock Text="·" FontSize="11.5" Foreground="{StaticResource Text.Tertiary}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding BpmText, StringFormat='BPM {0}'}" FontSize="11.5" Foreground="{StaticResource Text.Secondary}" />
                                                </StackPanel>

                                                <!-- If Failed -->
                                                <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="{StaticResource Status.Danger}" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}" ToolTip="{Binding ErrorMessage}" />
                                            </StackPanel>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}">
                                                <Button Content="라이브러리에서 보기" Command="{Binding DataContext.ViewInLibraryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        Padding="10,5" Margin="0,0,8,0" FontSize="12" />
                                                <Button Content="바로 연주" Command="{Binding DataContext.OpenInPlayerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        Style="{StaticResource AccentButtonStyle}" Padding="12,5" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Bottom Actions & Progress Bar -->
        <Border Grid.Row="3" Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="32,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Progress Info -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ProgressStatusText}" FontSize="12" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding SummaryText}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Text.Primary}" />
                    </Grid>
                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="4" />
                </StackPanel>

                <!-- Right Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="목록 지우기" Command="{Binding ClearQueueCommand}" IsEnabled="{Binding IsImporting, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" Padding="14,7" Margin="0,0,8,0" />
                    <Button Content="취소" Command="{Binding CancelImportCommand}" Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}" Padding="16,7" Margin="0,0,8,0" />
                    <Button Content="가져오기 시작" Command="{Binding StartImportCommand}" Style="{StaticResource AccentButtonStyle}" IsEnabled="{Binding HasItems}" Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" Padding="20,7" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
