<UserControl x:Class="RobloxPiano.Desktop.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RobloxPiano.Desktop.ViewModels"
             mc:Ignorable="d" 
             Background="{StaticResource Background.Root}"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Background="{StaticResource Background.Root}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Pane (250 DIP) -->
        <Border Grid.Column="0" Background="{StaticResource Surface.Base}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="홈" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" Margin="20,16,20,10" />
                
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,0,8,12">
                        <!-- Root Library Location -->
                        <Button HorizontalContentAlignment="Left" Height="34" Padding="12,0" Margin="0,0,0,3" BorderThickness="0"
                                Command="{Binding NavigateToFolderCommand}" CommandParameter="{x:Null}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRootView}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Surface.Selected}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="18" Height="18" Margin="0,0,10,0">
                                    <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Fill="{StaticResource Accent.Primary}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="내 라이브러리" FontSize="12.5" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRootView}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent.Primary}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Favorites Location -->
                        <Button HorizontalContentAlignment="Left" Height="34" Padding="12,0" Margin="0,0,0,4" BorderThickness="0"
                                Command="{Binding NavigateToFavoritesCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavoritesView}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Surface.Selected}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="18" Height="18" Margin="0,0,10,0">
                                    <Path Data="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" Fill="{StaticResource Status.Warning}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="즐겨찾기" FontSize="12.5" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavoritesView}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent.Primary}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        
                        <Separator Background="{StaticResource Border.Subtle}" Margin="6,6" />
                        
                        <!-- Folders Header -->
                        <TextBlock Text="폴더" Foreground="{StaticResource Text.Tertiary}" FontSize="11.5" FontWeight="SemiBold" Margin="12,4,0,6" />
                        
                        <!-- Hierarchical Folder List -->
                        <ItemsControl ItemsSource="{Binding FolderList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FolderItemViewModel}">
                                    <Button HorizontalContentAlignment="Left" Height="34" Padding="{Binding IndentPadding}" Margin="0,0,0,2" BorderThickness="0"
                                            PreviewMouseRightButtonDown="FolderButton_PreviewMouseRightButtonDown"
                                            Command="{Binding DataContext.NavigateToFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="열기" Command="{Binding DataContext.NavigateToFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding Id}" />
                                                <MenuItem Header="이름 바꾸기" Command="{Binding DataContext.RenameSelectedItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Separator />
                                                <MenuItem Header="삭제" Command="{Binding DataContext.DeleteSelectedItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Surface.Selected}" />
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsSelected}" Value="True" />
                                                            <Condition Binding="{Binding IsCurrent}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{StaticResource Surface.Hover}" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="18" Margin="0,0,8,0">
                                                <Path Data="{Binding Icon}" Fill="{StaticResource Text.Secondary}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Accent.Primary}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Right Content Area (Full Dark Root) -->
        <Grid Grid.Column="1" Background="{StaticResource Background.Root}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <!-- Top Row: Address & Search -->
            <Grid Grid.Row="0" Margin="16,10" Background="{StaticResource Background.Root}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                
                <!-- Back / Forward / Up -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Width="30" Height="30" Padding="6" Margin="0,0,3,0" Background="Transparent" BorderThickness="0" Command="{Binding NavigateBackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip="뒤로">
                        <Path Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" Fill="{StaticResource Text.Primary}" Stretch="Uniform" />
                    </Button>
                    <Button Width="30" Height="30" Padding="6" Margin="0,0,3,0" Background="Transparent" BorderThickness="0" Command="{Binding NavigateForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip="앞으로">
                        <Path Data="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z" Fill="{StaticResource Text.Primary}" Stretch="Uniform" />
                    </Button>
                    <Button Width="30" Height="30" Padding="6" Background="Transparent" BorderThickness="0" Command="{Binding NavigateUpCommand}" IsEnabled="{Binding CanGoUp}" ToolTip="상위 폴더로">
                        <Path Data="M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z" Fill="{StaticResource Text.Primary}" Stretch="Uniform" />
                    </Button>
                </StackPanel>
                
                <!-- Address Bar -->
                <Border Grid.Column="1" Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="4" Padding="10,0" Margin="0,0,12,0" Height="32">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Fill="{StaticResource Text.Secondary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding BreadcrumbPath}" FontSize="12" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                
                <!-- Search Box -->
                <TextBox Grid.Column="2" Height="32" VerticalContentAlignment="Center" BorderThickness="1" BorderBrush="{StaticResource Border.Subtle}" Background="{StaticResource Surface.Elevated}" Padding="8,4" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource Text.Primary}"/>
            </Grid>

            <!-- Command Bar (Cleaned, no duplicate MML import) -->
            <Border Grid.Row="1" Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,1" Padding="14,6">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <Button Margin="0,0,6,0" Padding="8,4" Background="Transparent" BorderThickness="0" Command="{Binding CreateFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M20 6h-8l-2-2H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-1 8h-3v3h-2v-3h-3v-2h3V9h2v3h3v2z" Fill="{StaticResource Text.Primary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="새 폴더" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,8,0" Padding="8,4" Background="Transparent" BorderThickness="0" Command="{Binding AddFilesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 14h-3v3h-2v-3H8v-2h3v-3h2v3h3v2zm-3-7V3.5L18.5 9H13z" Fill="{StaticResource Text.Primary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="파일 추가" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        
                        <Separator Background="{StaticResource Border.Subtle}" Margin="4,2,8,2"/>
                        
                        <Button Margin="0,0,3,0" Padding="7,4" Background="Transparent" BorderThickness="0" ToolTip="잘라내기" Command="{Binding CutSelectedScoreCommand}" IsEnabled="{Binding CanCutSelectedItem}">
                            <Path Data="M9.64 7.64c.23-.5.36-1.05.36-1.64 0-2.21-1.79-4-4-4S2 3.79 2 6s1.79 4 4 4c.59 0 1.14-.13 1.64-.36L10 12l-2.36 2.36C7.14 14.13 6.59 14 6 14c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4c0-.59-.13-1.14-.36-1.64L12 14l7 7h3v-1L9.64 7.64zM6 8c-1.1 0-2-.89-2-2s.9-2 2-2 2 .89 2 2-.9 2-2 2zm0 12c-1.1 0-2-.89-2-2s.9-2 2-2 2 .89 2 2-.9 2-2 2zm6-7.5c-.28 0-.5-.22-.5-.5s.22-.5.5-.5.5.22.5.5-.22.5-.5.5zM19 3l-6 6 2 2 7-7V3z" Fill="{StaticResource Text.Secondary}" Width="13" Height="13" Stretch="Uniform"/>
                        </Button>
                        <Button Margin="0,0,3,0" Padding="7,4" Background="Transparent" BorderThickness="0" ToolTip="복사" Command="{Binding CopySelectedScoreCommand}" IsEnabled="{Binding CanCopySelectedItem}">
                            <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Fill="{StaticResource Text.Secondary}" Width="13" Height="13" Stretch="Uniform"/>
                        </Button>
                        <Button Margin="0,0,3,0" Padding="7,4" Background="Transparent" BorderThickness="0" ToolTip="붙여넣기" Command="{Binding PasteScoreCommand}" IsEnabled="{Binding CanPaste}">
                            <Path Data="M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 18H5V4h2v3h10V4h2v16z" Fill="{StaticResource Text.Secondary}" Width="13" Height="13" Stretch="Uniform"/>
                        </Button>
                        <Button Margin="0,0,3,0" Padding="7,4" Background="Transparent" BorderThickness="0" ToolTip="이름 바꾸기" Command="{Binding RenameSelectedItemCommand}" IsEnabled="{Binding CanRenameSelectedItem}">
                            <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" Fill="{StaticResource Text.Secondary}" Width="13" Height="13" Stretch="Uniform"/>
                        </Button>
                        <Button Margin="0,0,8,0" Padding="7,4" Background="Transparent" BorderThickness="0" ToolTip="삭제" Command="{Binding DeleteSelectedItemCommand}" IsEnabled="{Binding CanDeleteSelectedItem}">
                            <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Fill="{StaticResource Status.Error}" Width="13" Height="13" Stretch="Uniform"/>
                        </Button>
                        
                        <Separator Background="{StaticResource Border.Subtle}" Margin="4,2,8,2"/>
                        
                        <Button x:Name="SortButton" Margin="0,0,4,0" Padding="8,4" Background="Transparent" BorderThickness="0" Click="SortButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="이름" Command="{Binding SetSortColumnCommand}" CommandParameter="Title"
                                              IsChecked="{Binding IsSortByTitle}" IsCheckable="True"/>
                                    <MenuItem Header="유형" Command="{Binding SetSortColumnCommand}" CommandParameter="FileExtension"
                                              IsChecked="{Binding IsSortByType}" IsCheckable="True"/>
                                    <MenuItem Header="길이" Command="{Binding SetSortColumnCommand}" CommandParameter="Duration"
                                              IsChecked="{Binding IsSortByDuration}" IsCheckable="True"/>
                                    <MenuItem Header="BPM" Command="{Binding SetSortColumnCommand}" CommandParameter="Bpm"
                                              IsChecked="{Binding IsSortByBpm}" IsCheckable="True"/>
                                    <MenuItem Header="음표 수" Command="{Binding SetSortColumnCommand}" CommandParameter="TotalNotes"
                                              IsChecked="{Binding IsSortByNotes}" IsCheckable="True"/>
                                    <MenuItem Header="수정한 날짜" Command="{Binding SetSortColumnCommand}" CommandParameter="UpdatedAt"
                                              IsChecked="{Binding IsSortByModified}" IsCheckable="True"/>
                                    <Separator />
                                    <MenuItem Header="오름차순" Command="{Binding SetSortDirectionCommand}" CommandParameter="False"
                                              IsChecked="{Binding IsSortAscending}" IsCheckable="True"/>
                                    <MenuItem Header="내림차순" Command="{Binding SetSortDirectionCommand}" CommandParameter="True"
                                              IsChecked="{Binding IsSortDescending}" IsCheckable="True"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3 18h6v-2H3v2zM3 6v2h18V6H3zm0 7h12v-2H3v2z" Fill="{StaticResource Text.Primary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="정렬" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Details List Area (With Real WPF Virtualization & Empty State) -->
            <Grid Grid.Row="2" Background="{StaticResource Background.Root}" Margin="16,8">
                <!-- Virtualized DataGrid -->
                <DataGrid ItemsSource="{Binding DisplayedScores}" SelectedItem="{Binding SelectedScore}"
                          AutoGenerateColumns="False" 
                          Background="{StaticResource Background.Root}" 
                          RowBackground="Transparent" AlternatingRowBackground="Transparent" 
                          GridLinesVisibility="None" HeadersVisibility="Column" BorderThickness="0"
                          RowHeight="36" FontSize="12.5" Foreground="{StaticResource Text.Primary}"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.ScrollChanged="DataGrid_ScrollChanged"
                          MouseDoubleClick="DataGrid_MouseDoubleClick">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="열기" Command="{Binding DataContext.OpenSelectedScoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                        <MenuItem Header="이름 바꾸기" Command="{Binding DataContext.RenameSelectedItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                        <Separator />
                                        <MenuItem Header="잘라내기" Command="{Binding DataContext.CutSelectedScoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                        <MenuItem Header="복사" Command="{Binding DataContext.CopySelectedScoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                        <MenuItem Header="붙여넣기" Command="{Binding DataContext.PasteScoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                        <Separator />
                                        <MenuItem Header="즐겨찾기 추가/제거" Command="{Binding DataContext.ToggleFavoriteScoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="삭제" Command="{Binding DataContext.DeleteSelectedItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.RowStyle>
                    
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="이름" Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{Binding Icon}" Fill="{StaticResource Text.Secondary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Foreground="{StaticResource Text.Primary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="유형" Binding="{Binding Type}" Width="90"/>
                        <DataGridTextColumn Header="길이" Binding="{Binding Duration}" Width="80"/>
                        <DataGridTextColumn Header="BPM" Binding="{Binding Bpm}" Width="60"/>
                        <DataGridTextColumn Header="음표 수" Binding="{Binding Notes}" Width="80"/>
                        <DataGridTextColumn Header="수정한 날짜" Binding="{Binding Modified}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Compact Empty State -->
                <Border Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="6"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,24"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="라이브러리가 비어 있습니다." FontSize="14" FontWeight="Medium" Foreground="{StaticResource Text.Primary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="파일이나 폴더를 추가하여 악보를 관리하세요." FontSize="12" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="파일 추가" Style="{StaticResource AccentButtonStyle}" Padding="16,6" Margin="0,0,8,0" Command="{Binding AddFilesCommand}"/>
                            <Button Content="새 폴더" Padding="16,6" Command="{Binding CreateFolderCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Status Bar -->
            <Border Grid.Row="3" Background="{StaticResource Surface.Base}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource Text.Secondary}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
