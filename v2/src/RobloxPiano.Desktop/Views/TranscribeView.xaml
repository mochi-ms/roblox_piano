<UserControl x:Class="RobloxPiano.Desktop.Views.TranscribeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RobloxPiano.Desktop.ViewModels"
             mc:Ignorable="d" 
             Background="{StaticResource Background.Root}"
             d:DesignHeight="700" d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Area -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="오디오에서 악보 만들기" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,4" />
                <TextBlock Text="로컬 오디오를 불러와 분석 가능한 형식으로 준비합니다." FontSize="13" Foreground="{StaticResource Text.Secondary}" />
            </StackPanel>

            <Border Grid.Column="1" Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                <TextBlock Text="{Binding FfmpegStatusText}" FontSize="11.5" Foreground="{StaticResource Text.Secondary}" />
            </Border>
        </Grid>

        <!-- 2. Drop Zone Area -->
        <Border Grid.Row="1"
                Background="{StaticResource Surface.Elevated}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24,28"
                Margin="0,0,0,20"
                AllowDrop="True"
                DragEnter="DropZone_DragEnter"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="오디오 파일을 여기에 놓으세요" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,6" />
                    <TextBlock Text="지원 포맷: MP3 · WAV · M4A · FLAC · AAC · OGG (최대 500MB, 30분)" FontSize="12" Foreground="{StaticResource Text.Secondary}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="파일 선택" Command="{Binding BrowseFilesCommand}" Style="{StaticResource AccentButtonStyle}" Padding="18,8" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Queue List Area -->
        <Border Grid.Row="2" Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Queue Header -->
                <Border Grid.Row="0" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="16,10" Background="{StaticResource Background.Root}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="파일명" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Grid.Column="1" Text="형식" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Grid.Column="2" Text="재생 시간" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Grid.Column="3" Text="상태" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Grid.Column="4" Text="진행률" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Grid.Column="5" Text="작업" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Empty State -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"
                            Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                    <TextBlock Text="대기 중인 오디오 파일이 없습니다." FontSize="13" Foreground="{StaticResource Text.Tertiary}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock Text="오디오 파일을 드래그하여 놓거나 [파일 선택]을 클릭하세요." FontSize="11.5" Foreground="{StaticResource Text.Tertiary}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Items List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding QueueItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AudioQueueItemViewModel}">
                                <Border BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Filename + Tooltip Error -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource Text.Primary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="{StaticResource Status.Error}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Format -->
                                        <TextBlock Grid.Column="1" Text="{Binding SourceType}" FontSize="12" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" />

                                        <!-- Duration -->
                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="12" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" />

                                        <!-- Status Badge -->
                                        <Border Grid.Column="3" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{StaticResource Surface.Card}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Text.Primary}" />
                                        </Border>

                                        <!-- Progress Bar -->
                                        <ProgressBar Grid.Column="4" Value="{Binding ProgressPercent}" Maximum="100" Height="6" VerticalAlignment="Center" Margin="0,0,12,0" />

                                        <!-- Action: Open Folder -->
                                        <Button Grid.Column="5" Content="폴더 열기" Padding="8,4" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                IsEnabled="{Binding IsPrepared}"
                                                Command="{Binding DataContext.OpenWorkspaceFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 4. Bottom Action & Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Progress / Summary Status -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding ProgressStatusText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding SummaryText}" FontSize="11.5" Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="목록 비우기" Command="{Binding ClearQueueCommand}"
                            IsEnabled="{Binding IsProcessing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                            Margin="0,0,8,0" Padding="14,8" />

                    <Button Content="취소" Command="{Binding CancelIngestCommand}"
                            IsEnabled="{Binding IsProcessing}"
                            Margin="0,0,8,0" Padding="14,8" />

                    <Button Content="오디오 준비" Command="{Binding StartIngestCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{Binding IsProcessing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                            Padding="20,8" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
