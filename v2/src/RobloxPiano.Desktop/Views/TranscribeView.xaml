<UserControl x:Class="RobloxPiano.Desktop.Views.TranscribeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RobloxPiano.Desktop.ViewModels"
             mc:Ignorable="d" 
             Background="{StaticResource Background.Root}"
             d:DesignHeight="800" d:DesignWidth="1150">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Area -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="오디오에서 악보 만들기 (AI Transcription)" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,4" />
                <TextBlock Text="로컬 오디오 또는 YouTube 링크를 불러와 Spotify Basic Pitch AI로 피아노 악보(MIDI)를 생성합니다." FontSize="13" Foreground="{StaticResource Text.Secondary}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                    <TextBlock Text="{Binding FfmpegStatusText}" FontSize="11.5" Foreground="{StaticResource Text.Secondary}" />
                </Border>
                <Border Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                    <TextBlock Text="{Binding YtDlpStatusText}" FontSize="11.5" Foreground="{StaticResource Text.Secondary}" />
                </Border>
                <Border Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                    <TextBlock Text="{Binding AiEngineStatusText}" FontSize="11.5" Foreground="{StaticResource Text.Secondary}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- 2. Source Input Area (Local Drop Zone + YouTube Link Input) -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>

            <!-- 2-A. Local Audio Drop Zone -->
            <Border Grid.Column="0"
                    Background="{StaticResource Surface.Elevated}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16"
                    AllowDrop="True"
                    DragEnter="DropZone_DragEnter"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="로컬 오디오 파일 불러오기" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,4" />
                        <TextBlock Text="MP3 · WAV · M4A · FLAC · AAC · OGG (최대 500MB, 30분)" FontSize="11.5" Foreground="{StaticResource Text.Secondary}" />
                    </StackPanel>

                    <Button Grid.Column="1" Content="파일 선택" Command="{Binding BrowseFilesCommand}" Style="{StaticResource AccentButtonStyle}" Padding="16,7" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 2-B. YouTube Link Input -->
            <Border Grid.Column="2"
                    Background="{StaticResource Surface.Elevated}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="YouTube에서 가져오기" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,2" />
                        <TextBlock Text="일반 영상, Shorts, youtu.be 링크 (단일 영상 전용)" FontSize="11.5" Foreground="{StaticResource Text.Secondary}" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding YouTubeUrlInput, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,6"
                                 FontSize="12"
                                 Background="{StaticResource Surface.Card}"
                                 Foreground="{StaticResource Text.Primary}"
                                 BorderBrush="{StaticResource Border.Subtle}"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Center" />

                        <Button Grid.Column="2"
                                Content="링크 추가"
                                Command="{Binding AddYouTubeUrlCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="14,6" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Queue List Area -->
        <Border Grid.Row="2" Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Queue Header -->
                <Border Grid.Row="0" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="16,10" Background="{StaticResource Background.Root}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*" />
                            <ColumnDefinition Width="75" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="파일명 / YouTube 제목" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Grid.Column="1" Text="형식" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Grid.Column="2" Text="길이" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Grid.Column="3" Text="상태" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Grid.Column="4" Text="진행률 / AI 상태" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Grid.Column="5" Text="악보 분석 통계" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Grid.Column="6" Text="작업" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Empty State -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"
                            Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                    <TextBlock Text="대기 중인 오디오 파일 또는 YouTube 링크가 없습니다." FontSize="13" Foreground="{StaticResource Text.Tertiary}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock Text="오디오 파일을 드래그하여 놓거나 YouTube 영상 링크를 추가하세요." FontSize="11.5" Foreground="{StaticResource Text.Tertiary}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Items List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding QueueItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AudioQueueItemViewModel}">
                                <Border BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="2.5*" />
                                             <ColumnDefinition Width="75" />
                                             <ColumnDefinition Width="80" />
                                             <ColumnDefinition Width="100" />
                                             <ColumnDefinition Width="140" />
                                             <ColumnDefinition Width="150" />
                                             <ColumnDefinition Width="200" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Filename + Error Tooltip -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource Text.Primary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="{StaticResource Status.Error}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Format -->
                                        <TextBlock Grid.Column="1" Text="{Binding SourceType}" FontSize="12" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" />

                                        <!-- Duration -->
                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="12" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" />

                                        <!-- Status Badge -->
                                        <Border Grid.Column="3" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{StaticResource Surface.Card}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Text.Primary}" />
                                        </Border>

                                        <!-- Progress Bar / Sub-Status -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <!-- Normalization Progress -->
                                            <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="5"
                                                         Visibility="{Binding IsAiProcessing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                            <!-- AI Indeterminate Progress -->
                                            <ProgressBar IsIndeterminate="True" Height="5"
                                                         Visibility="{Binding IsAiProcessing, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding AiStatusText}" FontSize="10.5" Foreground="{StaticResource Text.Secondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding IsAiProcessing, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>

                                        <!-- Note Stats -->
                                        <TextBlock Grid.Column="5" Text="{Binding NoteStatsText}" FontSize="11.5" Foreground="{StaticResource Accent.Primary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                        <!-- Row Action Buttons -->
                                        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Prepared -> AI Convert -->
                                            <Button Content="AI 악보 변환" Padding="8,4" FontSize="11"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Visibility="{Binding CanStartAi, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.StartAiTranscriptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Margin="0,0,4,0" />

                                            <!-- AI Completed -> Play -->
                                            <Button Content="바로 연주" Padding="8,4" FontSize="11"
                                                    Visibility="{Binding HasAiResult, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.OpenInPlayerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Margin="0,0,4,0" />

                                            <!-- AI Completed -> Add to Library -->
                                            <Button Content="라이브러리" Padding="8,4" FontSize="11"
                                                    Visibility="{Binding HasAiResult, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.AddToLibraryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Margin="0,0,4,0" />

                                            <!-- Folder -->
                                            <Button Content="폴더" Padding="6,4" FontSize="11"
                                                    IsEnabled="{Binding IsPrepared}"
                                                    Command="{Binding DataContext.OpenWorkspaceFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 4. Bottom Action & Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Progress / Summary Status -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding ProgressStatusText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding SummaryText}" FontSize="11.5" Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="목록 비우기" Command="{Binding ClearQueueCommand}"
                            IsEnabled="{Binding IsProcessing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                            Margin="0,0,8,0" Padding="14,8" />

                    <Button Content="취소"
                            Command="{Binding CancelIngestCommand}"
                            Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,8,0" Padding="14,8" />

                    <Button Content="AI 취소"
                            Command="{Binding CancelAiTranscriptionCommand}"
                            Visibility="{Binding IsAiProcessing, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,8,0" Padding="14,8" />

                    <Button Content="오디오 준비" Command="{Binding StartIngestCommand}"
                            IsEnabled="{Binding IsProcessing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                            Margin="0,0,8,0" Padding="16,8" />

                    <Button Content="준비된 파일 모두 분석" Command="{Binding StartBatchAiTranscriptionCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{Binding HasPreparedItems}"
                            Padding="18,8" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
