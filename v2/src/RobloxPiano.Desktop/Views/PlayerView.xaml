<UserControl x:Class="RobloxPiano.Desktop.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             Background="{StaticResource Background.Root}"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="{StaticResource Background.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="260" />
            <RowDefinition Height="84" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <!-- 1. Track Header & Compact Metadata Strip + Roblox Target Selector -->
        <Border Grid.Row="0" Background="{StaticResource Surface.Base}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,2"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource Surface.Hover}" CornerRadius="4" Padding="6,1" Margin="0,0,8,0">
                            <TextBlock Text="{Binding SourceType}" FontSize="11" Foreground="{StaticResource Text.Secondary}" FontWeight="Medium" />
                        </Border>
                        <TextBlock Text="{Binding TrackAndTempoInfo}" FontSize="11" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Piano Profile & Roblox Target Status & Selectors -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <!-- Piano Profile Selector (88-key vs 61-key) -->
                    <Border Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Default}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="건반:" FontSize="11.5" Foreground="{StaticResource Text.Secondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding AvailablePianoProfiles}"
                                      SelectedItem="{Binding SelectedPianoProfile, Mode=TwoWay}"
                                      MinWidth="120"
                                      MaxHeight="26"
                                      FontSize="11.5"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Default}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Status Indicator -->
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#EF4444" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRobloxConnected}" Value="True">
                                                <Setter Property="Fill" Value="#10B981" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <TextBlock Text="Roblox 대상:" FontSize="11.5" Foreground="{StaticResource Text.Secondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>

                            <!-- ComboBox for multiple Roblox targets, or text if 1/none -->
                            <ComboBox ItemsSource="{Binding AvailableRobloxWindows}"
                                      SelectedItem="{Binding SelectedRobloxWindow, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      MinWidth="140"
                                      MaxHeight="26"
                                      FontSize="11.5"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AvailableRobloxWindows.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>

                            <TextBlock Text="연결 안 됨" FontSize="11.5" Foreground="{StaticResource Text.Disabled}" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AvailableRobloxWindows.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Refresh Button -->
                            <Button Command="{Binding RefreshRobloxWindowsCommand}"
                                    ToolTip="Roblox 창 새로고침"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4,2"
                                    VerticalAlignment="Center">
                                <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                      Fill="{StaticResource Text.Secondary}"
                                      Width="12" Height="12"
                                      Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <!-- Compact Metadata Strip -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="길이" FontSize="11" Foreground="{StaticResource Text.Secondary}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FormattedDuration}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Rectangle Width="1" Height="14" Fill="{StaticResource Border.Subtle}" Margin="0,0,16,0" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="BPM" FontSize="11" Foreground="{StaticResource Text.Secondary}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FormattedBpm}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Rectangle Width="1" Height="14" Fill="{StaticResource Border.Subtle}" Margin="0,0,16,0" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="음표" FontSize="11" Foreground="{StaticResource Text.Secondary}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FormattedTotalNotes}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Rectangle Width="1" Height="14" Fill="{StaticResource Border.Subtle}" Margin="0,0,16,0" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="음역" FontSize="11" Foreground="{StaticResource Text.Secondary}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PitchRangeText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Real Timeline Piano Roll Workspace -->
        <Border Grid.Row="1" Background="{StaticResource Background.Deep}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Measure Timeline Ruler -->
                <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,1,1" />
                <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1">
                    <Canvas>
                        <TextBlock Text="1.1" Canvas.Left="20" Canvas.Top="4" FontSize="10" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Text="2.1" Canvas.Left="180" Canvas.Top="4" FontSize="10" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Text="3.1" Canvas.Left="340" Canvas.Top="4" FontSize="10" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Text="4.1" Canvas.Left="500" Canvas.Top="4" FontSize="10" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Text="5.1" Canvas.Left="660" Canvas.Top="4" FontSize="10" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Text="6.1" Canvas.Left="820" Canvas.Top="4" FontSize="10" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Text="7.1" Canvas.Left="980" Canvas.Top="4" FontSize="10" Foreground="{StaticResource Text.Secondary}" />
                    </Canvas>
                </Border>

                <!-- Pitch Gutter (Left Key Labels) -->
                <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Surface.Base}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,1,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="C7" Foreground="{StaticResource Text.Disabled}" FontSize="10" HorizontalAlignment="Right" Margin="0,4,8,4" />
                            <TextBlock Text="C6" Foreground="{StaticResource Text.Secondary}" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Right" Margin="0,4,8,4" />
                            <TextBlock Text="C5" Foreground="{StaticResource Text.Disabled}" FontSize="10" HorizontalAlignment="Right" Margin="0,4,8,4" />
                            <TextBlock Text="C4 (가온 C)" Foreground="{StaticResource Accent.Primary}" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Right" Margin="0,4,8,4" />
                            <TextBlock Text="C3" Foreground="{StaticResource Text.Disabled}" FontSize="10" HorizontalAlignment="Right" Margin="0,4,8,4" />
                            <TextBlock Text="C2" Foreground="{StaticResource Text.Secondary}" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Right" Margin="0,4,8,4" />
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Grid & Real Note Blocks & Dynamic Playhead -->
                <ScrollViewer Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid Width="{Binding PianoRollWidth}" Height="250" ClipToBounds="True">
                        <!-- Horizontal Pitch Lines -->
                        <Path Data="M0,20 H5000 M0,50 H5000 M0,80 H5000 M0,110 H5000 M0,140 H5000 M0,170 H5000 M0,200 H5000 M0,230 H5000" Stroke="{StaticResource Border.Subtle}" StrokeThickness="0.5" Opacity="0.4" />
                        
                        <!-- Empty State Notice when no score is loaded -->
                        <TextBlock Text="악보를 선택하면 실제 피아노 롤 노트가 표시됩니다." 
                                   Foreground="{StaticResource Text.Disabled}" FontSize="13" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasScore}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Real Timeline Note ItemsControl -->
                        <ItemsControl ItemsSource="{Binding PianoRollNotes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding CanvasTop}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding ColorBrushKey}" CornerRadius="2" Width="{Binding Width}" Height="{Binding Height}" Opacity="0.95" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Continuous Monotonic Playhead Line -->
                        <Canvas>
                            <Rectangle Width="2" Fill="{StaticResource Accent.Primary}" Height="250" Canvas.Left="{Binding PlayheadCanvasLeft}" Canvas.Top="0" Opacity="0.95" />
                        </Canvas>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 3. Virtual Piano Interactive Keyboard (Profile-Driven) -->
        <Border Grid.Row="2" Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="12,12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Center">
                <!-- Real Binding-Driven Piano Keys -->
                <ItemsControl ItemsSource="{Binding PianoKeys}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="{Binding KeyboardCanvasWidth}" Height="56" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding KeyLeft}"/>
                            <Setter Property="Canvas.Top" Value="0"/>
                            <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="KeyBorder" Width="{Binding KeyWidth}" Height="{Binding KeyHeight}" CornerRadius="0,0,2,2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <!-- Default White Key -->
                                        <Setter Property="Background" Value="#D8DEE4"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Border.Default}"/>
                                        <Setter Property="BorderThickness" Value="1,0,1,1"/>
                                        
                                        <Style.Triggers>
                                            <!-- Black Key Trigger -->
                                            <DataTrigger Binding="{Binding IsBlack}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Surface.Elevated}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Background.Deep}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </DataTrigger>
                                            
                                            <!-- Active White Key Trigger -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsBlack}" Value="False"/>
                                                    <Condition Binding="{Binding IsActive}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="{StaticResource Accent.Primary}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Accent.Hover}"/>
                                            </MultiDataTrigger>

                                            <!-- Active Black Key Trigger -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsBlack}" Value="True"/>
                                                    <Condition Binding="{Binding IsActive}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="{StaticResource Accent.Hover}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Accent.Primary}"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 4. Transport Bar (Desktop Compact DAW Style) -->
        <Border Grid.Row="3" Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                
                <!-- Time & Playback Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FormattedCurrentTime}" FontSize="13" Foreground="{StaticResource Text.Primary}" FontWeight="SemiBold" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding FormattedTotalTime}" FontSize="12.5" Foreground="{StaticResource Text.Secondary}" Margin="0,0,12,0"/>
                    <Border Background="#162D20" BorderBrush="{StaticResource Status.Success}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource Status.Success}" FontWeight="Medium" />
                    </Border>
                </StackPanel>
                
                <!-- Center Playback Controls & Timeline -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Padding="14,8" Margin="0,0,6,0" Background="{StaticResource Surface.Hover}" BorderBrush="{StaticResource Border.Default}" BorderThickness="1" 
                            Command="{Binding TogglePlayPauseCommand}" ToolTip="재생 / 일시정지 (F6)">
                        <Path Data="M8 5v14l11-7z" Fill="{StaticResource Text.Primary}" Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <Button Padding="8,6" Margin="0,0,20,0" Background="Transparent" BorderThickness="0" 
                            Command="{Binding StopCommand}" ToolTip="정지 (Esc)">
                        <Path Data="M6 6h12v12H6z" Fill="{StaticResource Text.Primary}" Width="13" Height="13" Stretch="Uniform" />
                    </Button>

                    <!-- Timeline Seek Slider -->
                    <Slider Width="280" VerticalAlignment="Center" Minimum="0" Maximum="{Binding TotalTime}" Value="{Binding CurrentTime, Mode=TwoWay}" Margin="0,0,16,0" />
                </StackPanel>
                
                <!-- Modifiers (Full Speed & Transpose Support) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <TextBlock Text="속도" FontSize="11.5" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="72" SelectedValuePath="Tag" SelectedValue="{Binding SelectedSpeed}">
                            <ComboBoxItem Content="0.25x"><ComboBoxItem.Tag><sys:Double>0.25</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="0.50x"><ComboBoxItem.Tag><sys:Double>0.5</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="0.75x"><ComboBoxItem.Tag><sys:Double>0.75</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="1.00x"><ComboBoxItem.Tag><sys:Double>1.0</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="1.25x"><ComboBoxItem.Tag><sys:Double>1.25</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="1.50x"><ComboBoxItem.Tag><sys:Double>1.5</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="2.00x"><ComboBoxItem.Tag><sys:Double>2.0</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="3.00x"><ComboBoxItem.Tag><sys:Double>3.0</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="조옮김" FontSize="11.5" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="60" SelectedValuePath="Tag" SelectedValue="{Binding SelectedTranspose}">
                            <ComboBoxItem Content="-24"><ComboBoxItem.Tag><sys:Int32>-24</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="-12"><ComboBoxItem.Tag><sys:Int32>-12</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="-7"><ComboBoxItem.Tag><sys:Int32>-7</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="-2"><ComboBoxItem.Tag><sys:Int32>-2</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="-1"><ComboBoxItem.Tag><sys:Int32>-1</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="0"><ComboBoxItem.Tag><sys:Int32>0</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="+1"><ComboBoxItem.Tag><sys:Int32>1</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="+2"><ComboBoxItem.Tag><sys:Int32>2</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="+7"><ComboBoxItem.Tag><sys:Int32>7</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="+12"><ComboBoxItem.Tag><sys:Int32>12</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="+24"><ComboBoxItem.Tag><sys:Int32>24</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
