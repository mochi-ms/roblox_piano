<UserControl x:Class="RobloxPiano.Desktop.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             Background="{StaticResource Background.Root}"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="{StaticResource Background.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="260" />
            <RowDefinition Height="84" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <!-- 1. Track Header & Compact Metadata Strip -->
        <Border Grid.Row="0" Background="{StaticResource Surface.Base}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,3"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource Surface.Hover}" CornerRadius="4" Padding="6,1" Margin="0,0,8,0">
                            <TextBlock Text="{Binding SourceType}" FontSize="11" Foreground="{StaticResource Text.Secondary}" FontWeight="Medium" />
                        </Border>
                        <TextBlock Text="{Binding TrackAndTempoInfo}" FontSize="11.5" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                
                <!-- Compact Metadata Strip -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="길이" FontSize="11" Foreground="{StaticResource Text.Secondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FormattedDuration}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Rectangle Width="1" Height="14" Fill="{StaticResource Border.Subtle}" Margin="0,0,20,0" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="BPM" FontSize="11" Foreground="{StaticResource Text.Secondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FormattedBpm}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Rectangle Width="1" Height="14" Fill="{StaticResource Border.Subtle}" Margin="0,0,20,0" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="음표" FontSize="11" Foreground="{StaticResource Text.Secondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FormattedTotalNotes}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Rectangle Width="1" Height="14" Fill="{StaticResource Border.Subtle}" Margin="0,0,20,0" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="음역" FontSize="11" Foreground="{StaticResource Text.Secondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PitchRangeText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Piano Roll Workspace (Visual DAW Layout) -->
        <Border Grid.Row="1" Background="{StaticResource Background.Deep}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Measure Timeline Ruler -->
                <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,1,1" />
                <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1">
                    <Canvas>
                        <TextBlock Text="1.1" Canvas.Left="20" Canvas.Top="4" FontSize="10" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Text="2.1" Canvas.Left="140" Canvas.Top="4" FontSize="10" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Text="3.1" Canvas.Left="260" Canvas.Top="4" FontSize="10" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Text="4.1" Canvas.Left="380" Canvas.Top="4" FontSize="10" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Text="5.1" Canvas.Left="500" Canvas.Top="4" FontSize="10" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Text="6.1" Canvas.Left="620" Canvas.Top="4" FontSize="10" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Text="7.1" Canvas.Left="740" Canvas.Top="4" FontSize="10" Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Text="8.1" Canvas.Left="860" Canvas.Top="4" FontSize="10" Foreground="{StaticResource Text.Secondary}" />
                    </Canvas>
                </Border>

                <!-- Pitch Gutter (Left Key Labels) -->
                <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Surface.Base}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,1,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="G5" Foreground="{StaticResource Text.Disabled}" FontSize="10.5" HorizontalAlignment="Right" Margin="0,10,8,10" />
                            <TextBlock Text="C5" Foreground="{StaticResource Text.Secondary}" FontWeight="SemiBold" FontSize="10.5" HorizontalAlignment="Right" Margin="0,10,8,10" />
                            <TextBlock Text="G4" Foreground="{StaticResource Text.Disabled}" FontSize="10.5" HorizontalAlignment="Right" Margin="0,10,8,10" />
                            <TextBlock Text="C4" Foreground="{StaticResource Text.Primary}" FontWeight="SemiBold" FontSize="10.5" HorizontalAlignment="Right" Margin="0,10,8,10" />
                            <TextBlock Text="G3" Foreground="{StaticResource Text.Disabled}" FontSize="10.5" HorizontalAlignment="Right" Margin="0,10,8,10" />
                            <TextBlock Text="C3" Foreground="{StaticResource Text.Secondary}" FontWeight="SemiBold" FontSize="10.5" HorizontalAlignment="Right" Margin="0,10,8,10" />
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Grid & Note Blocks -->
                <Grid Grid.Row="1" Grid.Column="1" ClipToBounds="True">
                    <!-- Measure Vertical Grid Lines -->
                    <Path Data="M140,0 V1000 M260,0 V1000 M380,0 V1000 M500,0 V1000 M620,0 V1000 M740,0 V1000 M860,0 V1000 M980,0 V1000" Stroke="{StaticResource Border.Subtle}" StrokeThickness="1" Opacity="0.7" />
                    <!-- Sub-beat Grid Lines -->
                    <Path Data="M80,0 V1000 M200,0 V1000 M320,0 V1000 M440,0 V1000 M560,0 V1000 M680,0 V1000 M800,0 V1000 M920,0 V1000" Stroke="{StaticResource Border.Subtle}" StrokeThickness="0.5" StrokeDashArray="2,2" Opacity="0.3" />
                    <!-- Horizontal Pitch Lines -->
                    <Path Data="M0,30 H2500 M0,60 H2500 M0,90 H2500 M0,120 H2500 M0,150 H2500 M0,180 H2500 M0,210 H2500 M0,240 H2500 M0,270 H2500 M0,300 H2500" Stroke="{StaticResource Border.Subtle}" StrokeThickness="0.5" Opacity="0.4" />
                    
                    <!-- Track 1 Note Blocks -->
                    <Border Background="{StaticResource Accent.Primary}" CornerRadius="2" Width="44" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,95,0,0" />
                    <Border Background="{StaticResource Accent.Primary}" CornerRadius="2" Width="68" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="90,65,0,0" />
                    <Border Background="{StaticResource Accent.Primary}" CornerRadius="2" Width="36" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="165,95,0,0" />
                    <Border Background="{StaticResource Accent.Primary}" CornerRadius="2" Width="52" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="210,125,0,0" />
                    <Border Background="{StaticResource Accent.Primary}" CornerRadius="2" Width="76" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="270,65,0,0" />
                    <Border Background="{StaticResource Accent.Primary}" CornerRadius="2" Width="40" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="355,95,0,0" />
                    <Border Background="{StaticResource Accent.Primary}" CornerRadius="2" Width="58" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="405,125,0,0" />
                    <Border Background="{StaticResource Accent.Primary}" CornerRadius="2" Width="92" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="470,65,0,0" />
                    <Border Background="{StaticResource Accent.Primary}" CornerRadius="2" Width="48" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="570,95,0,0" />

                    <!-- Track 2 Bass Note Blocks -->
                    <Border Background="{StaticResource Status.Success}" CornerRadius="2" Width="110" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,215,0,0" />
                    <Border Background="{StaticResource Status.Success}" CornerRadius="2" Width="110" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150,245,0,0" />
                    <Border Background="{StaticResource Status.Success}" CornerRadius="2" Width="110" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="270,215,0,0" />
                    <Border Background="{StaticResource Status.Success}" CornerRadius="2" Width="110" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="390,185,0,0" />
                    <Border Background="{StaticResource Status.Success}" CornerRadius="2" Width="110" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="510,215,0,0" />
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Virtual Piano Interactive Keyboard (61-Key Layout) -->
        <Border Grid.Row="2" Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="56" />
                </Grid.RowDefinitions>

                <!-- Octave Header Labels -->
                <Grid Grid.Row="0" Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="133" />
                        <ColumnDefinition Width="133" />
                        <ColumnDefinition Width="133" />
                        <ColumnDefinition Width="133" />
                        <ColumnDefinition Width="133" />
                        <ColumnDefinition Width="19" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="C2" FontSize="9.5" Foreground="{StaticResource Text.Disabled}" HorizontalAlignment="Left" Margin="2,0,0,0" />
                    <TextBlock Grid.Column="1" Text="C3" FontSize="9.5" Foreground="{StaticResource Text.Disabled}" HorizontalAlignment="Left" Margin="2,0,0,0" />
                    <TextBlock Grid.Column="2" Text="C4 (가온 C)" FontSize="9.5" Foreground="{StaticResource Accent.Primary}" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="2,0,0,0" />
                    <TextBlock Grid.Column="3" Text="C5" FontSize="9.5" Foreground="{StaticResource Text.Disabled}" HorizontalAlignment="Left" Margin="2,0,0,0" />
                    <TextBlock Grid.Column="4" Text="C6" FontSize="9.5" Foreground="{StaticResource Text.Disabled}" HorizontalAlignment="Left" Margin="2,0,0,0" />
                    <TextBlock Grid.Column="5" Text="C7" FontSize="9.5" Foreground="{StaticResource Text.Disabled}" HorizontalAlignment="Left" Margin="2,0,0,0" />
                </Grid>

                <!-- Piano Keys -->
                <Grid Grid.Row="1">
                    <!-- Layer 1: White Keys (Off-white #D8DEE4) -->
                    <StackPanel Orientation="Horizontal">
                        <!-- Octave 2 (C2-B2) -->
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />

                        <!-- Octave 3 (C3-B3) -->
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />

                        <!-- Octave 4 (C4-B4) -->
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />

                        <!-- Octave 5 (C5-B5) -->
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />

                        <!-- Octave 6 (C6-B6) -->
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                        <Border Width="18" Margin="0,0,1,0" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />

                        <!-- Top C7 -->
                        <Border Width="18" Background="#D8DEE4" CornerRadius="0,0,3,3" BorderBrush="{StaticResource Border.Default}" BorderThickness="1,0,1,1" />
                    </StackPanel>

                    <!-- Layer 2: Black Keys -->
                    <Canvas Height="34" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <!-- Octave 2 Black Keys -->
                        <Border Canvas.Left="13" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />
                        <Border Canvas.Left="32" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />
                        <Border Canvas.Left="70" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />
                        <Border Canvas.Left="89" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />
                        <Border Canvas.Left="108" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />

                        <!-- Octave 3 Black Keys -->
                        <Border Canvas.Left="146" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />
                        <Border Canvas.Left="165" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />
                        <Border Canvas.Left="203" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />
                        <Border Canvas.Left="222" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />
                        <Border Canvas.Left="241" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />

                        <!-- Octave 4 Black Keys -->
                        <Border Canvas.Left="279" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />
                        <Border Canvas.Left="298" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />
                        <Border Canvas.Left="336" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />
                        <Border Canvas.Left="355" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />
                        <Border Canvas.Left="374" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />

                        <!-- Octave 5 Black Keys -->
                        <Border Canvas.Left="412" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />
                        <Border Canvas.Left="431" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />
                        <Border Canvas.Left="469" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />
                        <Border Canvas.Left="488" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />
                        <Border Canvas.Left="507" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />

                        <!-- Octave 6 Black Keys -->
                        <Border Canvas.Left="545" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />
                        <Border Canvas.Left="564" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />
                        <Border Canvas.Left="602" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />
                        <Border Canvas.Left="621" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />
                        <Border Canvas.Left="640" Width="11" Height="34" Background="{StaticResource Surface.Elevated}" CornerRadius="0,0,2,2" BorderBrush="{StaticResource Background.Deep}" BorderThickness="1" />
                    </Canvas>
                </Grid>
            </Grid>
        </Border>

        <!-- 4. Transport Bar (Desktop Compact DAW Style) -->
        <Border Grid.Row="3" Background="{StaticResource Surface.Elevated}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                
                <!-- Time & Playback Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FormattedCurrentTime}" FontSize="13" Foreground="{StaticResource Text.Primary}" FontWeight="SemiBold" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding FormattedTotalTime}" FontSize="12.5" Foreground="{StaticResource Text.Secondary}" Margin="0,0,12,0"/>
                    <Border Background="#162D20" BorderBrush="{StaticResource Status.Success}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource Status.Success}" FontWeight="Medium" />
                    </Border>
                </StackPanel>
                
                <!-- Center Playback Controls & Timeline -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Padding="14,8" Margin="0,0,6,0" Background="{StaticResource Surface.Hover}" BorderBrush="{StaticResource Border.Default}" BorderThickness="1" 
                            Command="{Binding TogglePlayPauseCommand}" ToolTip="재생 / 일시정지 (F6)">
                        <Path Data="M8 5v14l11-7z" Fill="{StaticResource Text.Primary}" Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <Button Padding="8,6" Margin="0,0,20,0" Background="Transparent" BorderThickness="0" 
                            Command="{Binding StopCommand}" ToolTip="정지 (Esc)">
                        <Path Data="M6 6h12v12H6z" Fill="{StaticResource Text.Primary}" Width="13" Height="13" Stretch="Uniform" />
                    </Button>

                    <!-- Timeline Seek Slider -->
                    <Slider Width="280" VerticalAlignment="Center" Minimum="0" Maximum="{Binding TotalTime}" Value="{Binding CurrentTime, Mode=TwoWay}" Margin="0,0,16,0" />
                </StackPanel>
                
                <!-- Modifiers (Speed & Transpose) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <TextBlock Text="속도" FontSize="11.5" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="72" SelectedValuePath="Tag" SelectedValue="{Binding SelectedSpeed}">
                            <ComboBoxItem Content="0.50x"><ComboBoxItem.Tag><sys:Double>0.5</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="0.75x"><ComboBoxItem.Tag><sys:Double>0.75</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="1.00x"><ComboBoxItem.Tag><sys:Double>1.0</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="1.25x"><ComboBoxItem.Tag><sys:Double>1.25</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="1.50x"><ComboBoxItem.Tag><sys:Double>1.5</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="2.00x"><ComboBoxItem.Tag><sys:Double>2.0</sys:Double></ComboBoxItem.Tag></ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="조옮김" FontSize="11.5" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="60" SelectedValuePath="Tag" SelectedValue="{Binding SelectedTranspose}">
                            <ComboBoxItem Content="-12"><ComboBoxItem.Tag><sys:Int32>-12</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="-7"><ComboBoxItem.Tag><sys:Int32>-7</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="-2"><ComboBoxItem.Tag><sys:Int32>-2</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="-1"><ComboBoxItem.Tag><sys:Int32>-1</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="0"><ComboBoxItem.Tag><sys:Int32>0</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="+1"><ComboBoxItem.Tag><sys:Int32>1</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="+2"><ComboBoxItem.Tag><sys:Int32>2</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="+7"><ComboBoxItem.Tag><sys:Int32>7</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                            <ComboBoxItem Content="+12"><ComboBoxItem.Tag><sys:Int32>12</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
