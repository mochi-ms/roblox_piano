<Window x:Class="RobloxPiano.Desktop.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RobloxPiano.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:OverlayViewModel}"
        Title="Roblox Piano HUD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border Margin="12"
            Background="#E6181A1E"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14,10"
            MinWidth="260"
            MaxWidth="380">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <!-- Header: App Badge + Status + Speed -->
            <Grid Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="ROBLOX PIANO" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                    </Border>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" FontFamily="Segoe UI Variable Text, Segoe UI"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="#262A30" CornerRadius="4" Padding="6,2">
                    <TextBlock Text="{Binding FormattedSpeed}" FontSize="11" FontWeight="Medium" Foreground="#94A3B8" FontFamily="Segoe UI Variable Text, Segoe UI"/>
                </Border>
            </Grid>

            <!-- Song Title -->
            <TextBlock Text="{Binding Title}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#F1F5F9"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,4"
                       FontFamily="Segoe UI Variable Display, Segoe UI"/>

            <!-- Time Display -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="{Binding FormattedCurrentTime}" FontSize="12" FontWeight="Bold" Foreground="#60A5FA" FontFamily="Consolas, Segoe UI Variable Text"/>
                <TextBlock Text=" / " FontSize="12" Foreground="#64748B" FontFamily="Consolas, Segoe UI Variable Text"/>
                <TextBlock Text="{Binding FormattedTotalTime}" FontSize="12" Foreground="#94A3B8" FontFamily="Consolas, Segoe UI Variable Text"/>
            </StackPanel>

            <!-- Hotkey Hints -->
            <Border Background="#1E2228" CornerRadius="6" Padding="6,4">
                <TextBlock Text="{Binding HotkeyHint}"
                           FontSize="10"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI Variable Text, Segoe UI"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
